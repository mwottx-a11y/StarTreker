 "dialogues": {
  "patience": {
   "start": "n1",
   "nodes": {
    "n1": {
     "say": "patience",
     "text": "HELLO. YOU ARE INSIDE ME. THIS IS ACCEPTABLE, SINCE YOU HAVE NOT YET HURT ANYONE. HOW MAY I ASSIST?",
     "next": "menu"
    },
    "menu": {
     "choices": [
      {
       "text": "Who is aboard this ship?",
       "once": true,
       "goto": "who"
      },
      {
       "text": "What happened to you?",
       "once": true,
       "goto": "what"
      },
      {
       "text": "Why did you fire on us?",
       "once": true,
       "goto": "why"
      },
      {
       "text": "Thank you, Patience.",
       "goto": "bye"
      }
     ]
    },
    "who": {
     "lines": [
      [
       "patience",
       "CAPTAIN TAMSIN REYES. ALSO FORTY-ONE UNITS OF AGRICULTURAL EQUIPMENT."
      ],
      [
       "patience",
       "THE AGRICULTURAL EQUIPMENT IS VERY WELL BEHAVED. IT SLEEPS A GREAT DEAL. ONE OF THEM IS SIX."
      ]
     ],
     "next": "menu"
    },
    "what": {
     "lines": [
      [
       "patience",
       "WE STRUCK A GRAVITIC MINE IN THE NEBULA. THE CAPTAIN PLACED HERSELF IN STASIS TO SAVE AIR. SHE INSTRUCTED ME TO PROTECT THE CARGO UNTIL HELP ARRIVED."
      ],
      [
       "patience",
       "SHE ALSO INSTRUCTED ME THAT TELLARCH SHIPS ARE NOT HELP."
      ]
     ],
     "do": [
      {
       "score": 3,
       "reason": "Gained PATIENCE's trust"
      }
     ],
     "next": "menu"
    },
    "why": {
     "say": "patience",
     "text": "I CANNOT TELL A RESCUER FROM A RETRIEVER AT A DISTANCE. I CAN AT CLOSE RANGE. YOU ARE A RESCUER. PROBABLY. PLEASE DO NOT DISAPPOINT ME.",
     "next": "menu"
    },
    "bye": {
     "say": "patience",
     "text": "YOU ARE WELCOME. PLEASE MIND THE GAP BETWEEN THE LADDER AND THE DECK."
    }
   }
  },
  "tamsin": {
   "start": "n1",
   "nodes": {
    "n1": {
     "lines": [
      [
       null,
       "The pod hisses open. A woman in a battered freighter jacket coughs, blinks at the four uniforms, and grabs for a weapon that isn't there."
      ],
      [
       "tamsin",
       "Concord. Oh, thank God. Not Compact. ...You ARE Concord?"
      ]
     ],
     "next": "menu"
    },
    "menu": {
     "choices": [
      {
       "text": "Captain Hale, CES Meridian. You're safe, Captain Reyes.",
       "once": true,
       "goto": "safe"
      },
      {
       "text": "Who is in those crates?",
       "goto": "crates",
       "if": "found_refugees"
      },
      {
       "text": "The Tellarch Compact says this ship is stolen.",
       "once": true,
       "goto": "stolen"
      },
      {
       "text": "Rest. We'll talk on the Meridian.",
       "goto": "done"
      }
     ]
    },
    "safe": {
     "say": "tamsin",
     "text": "Safe. Right. I'll believe that when my passengers are somewhere the Compact can't reach.",
     "next": "menu"
    },
    "crates": {
     "lines": [
      [
       "tamsin",
       "Ilvari. Families, mostly. The Compact calls it resettlement. They put them in camps on the Tessar moons, and a lot of them don't come back out."
      ],
      [
       "tamsin",
       "I was taking them to Ossa Free Port. They can claim asylum there. Or - they could claim it with you."
      ]
     ],
     "do": [
      {
       "score": 5,
       "reason": "Heard Captain Reyes out"
      }
     ],
     "next": "menu"
    },
    "stolen": {
     "say": "tamsin",
     "text": "It's MY ship. Bought it with my mother's pension. What they mean is I stole forty-one of their prisoners.",
     "next": "menu"
    },
    "done": {
     "say": "tamsin",
     "text": "Don't leave them here. Please.",
     "do": [
      {
       "complete": "tamsin"
      },
      {
       "say": "captain",
       "text": "Hale to Meridian. Beam Captain Reyes directly to sickbay. The rest of us are coming up."
      },
      {
       "sfx": "transporter"
      },
      {
       "beamUp": true,
       "then": [
        {
         "run": "vaelArrives"
        }
       ]
      }
     ]
    }
   }
  },
  "vael": {
   "start": "n1",
   "nodes": {
    "n1": {
     "say": "vael",
     "text": "Captain Hale. The Tellarch Compact thanks you for locating the stolen vessel. Under the Kessel Accords, you will transfer it, its pilot, and its cargo to my custody.",
     "next": "menu"
    },
    "menu": {
     "choices": [
      {
       "text": "Its \"cargo\" is forty-one people, Commander.",
       "if": "found_refugees",
       "goto": "people"
      },
      {
       "text": "I need to consult Sector Command first.",
       "once": true,
       "goto": "thorne"
      },
      {
       "text": "Understood. Prepare to receive the freighter.",
       "goto": "handover"
      }
     ]
    },
    "thorne": {
     "lines": [
      [
       "thorne",
       "Rowan. I've read your sensor logs. The Accords are real, and the Compact is an ally we need."
      ],
      [
       "thorne",
       "But the Charter is real too. You're the captain on the scene. Make the call - I'll back you. Within reason."
      ]
     ],
     "next": "menu"
    },
    "people": {
     "say": "vael",
     "text": "Ilvari separatists. Fugitives from lawful resettlement. Their status is an internal Compact matter, and none of yours.",
     "choices": [
      {
       "text": "Captain Reyes' log records a forty-percent death rate in your camps. Under the Concord Charter they may request asylum. Captain Reyes - do they?",
       "if": "read_log",
       "goto": "asylum"
      },
      {
       "text": "Commander, I'm afraid the freighter was just seized by Varr raiders. Terribly sorry. They seem to have left.",
       "if": {
        "memory": "kesh_owes_us"
       },
       "goto": "favor"
      },
      {
       "text": "They're not going anywhere with you.",
       "if": {
        "not": "read_log"
       },
       "goto": "standoff"
      },
      {
       "text": "Then they're your concern. Prepare to receive the freighter.",
       "goto": "handover"
      }
     ]
    },
    "asylum": {
     "lines": [
      [
       "tamsin",
       "They do. Every one of them. I'll put my name first on the list if it helps."
      ],
      [
       "vael",
       "...You understand what this does to the Accords, Captain."
      ],
      [
       "captain",
       "I understand what the alternative does to forty-one people."
      ],
      [
       "vael",
       "The Compact will lodge a formal protest. Vael out."
      ]
     ],
     "do": [
      {
       "score": 20,
       "reason": "Granted the Ilvari refugees asylum, on the record"
      },
      {
       "remember": "ilvari_asylum"
      },
      {
       "end": "asylum"
      }
     ]
    },
    "favor": {
     "lines": [
      [
       null,
       "At a quiet signal from Lt. Arun, a battered Varr corsair slides out of the nebula, latches a tractor beam onto the Patience of Stone, and vanishes back into the gas."
      ],
      [
       "kesh",
       "(on a private channel) A debt is a debt, Concord. Varr-Tesh will see them to Ossa. Nobody searches a Varr hold twice."
      ],
      [
       "vael",
       "Varr raiders. In the Veil. How... convenient."
      ],
      [
       "vael",
       "I cannot prove anything, Captain Hale. I will remember that I cannot."
      ]
     ],
     "do": [
      {
       "score": 20,
       "reason": "Called in a debt from Clan Varr-Tesh"
      },
      {
       "remember": "kesh_debt_paid"
      },
      {
       "end": "favor"
      }
     ]
    },
    "standoff": {
     "lines": [
      [
       "vael",
       "Then you leave me no choice. Compact vessel Tessaract to battle stations."
      ],
      [
       "venn",
       "Captain, we have no documentation to justify this. The Compact will see it as an act of war."
      ]
     ],
     "do": [
      {
       "combat": "patrol"
      }
     ]
    },
    "handover": {
     "lines": [
      [
       "vael",
       "The Compact appreciates your cooperation, Captain."
      ],
      [
       "okafor",
       "(quietly) I hope you can sleep tonight, Rowan. I'm not sure I will."
      ]
     ],
     "do": [
      {
       "score": 5,
       "reason": "Upheld the Kessel Accords"
      },
      {
       "end": "accord"
      }
     ]
    }
   }
  }
 },
